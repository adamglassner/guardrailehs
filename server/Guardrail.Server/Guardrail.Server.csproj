<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Guardrail.Server</RootNamespace>
    <AssemblyName>GuardrailServer</AssemblyName>
    <Product>Guardrail Server</Product>
    <Company>Bytehawk Studio</Company>
    <Copyright>© 2026 Bytehawk Studio</Copyright>
    <!-- Releasing: change this and push to main. CI publishes the Docker image, standalone builds and the Windows installer as server-v<Version>. -->
    <Version>0.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>..\..\src\Guardrail.Desktop\Assets\guardrail.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Npgsql" Version="8.0.*" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Guardrail.Sync\Guardrail.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Guardrail.Server.Tests" />
  </ItemGroup>

</Project>
