<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Guardrail</RootNamespace>
    <AssemblyName>Guardrail</AssemblyName>
    <Product>Guardrail EHS</Product>
    <Company>Bytehawk Studio</Company>
    <Description>Free, open-source, self-hosted EHS and fleet safety software.</Description>
    <!-- Releasing: change this and push to main. CI builds, tests and publishes GitHub Release v<Version>. -->
    <Version>0.2.0</Version>
    <Authors>Bytehawk Studio</Authors>
    <Copyright>Copyright (c) 2026 Adam Glassner. MIT License.</Copyright>
    <!-- Lets the project at least restore/compile on non-Windows CI; the app itself is Windows-only. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\guardrail.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Single-file publish (build.ps1): bundle WPF's native DLLs into the exe too. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\guardrail.ico" />
    <Resource Include="Assets\guardrail.png" />
  </ItemGroup>

</Project>
