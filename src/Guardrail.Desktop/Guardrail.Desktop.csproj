<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK projections: built-in text recognition (Windows.Media.Ocr) and PDF rendering for attached documents. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Guardrail</RootNamespace>
    <AssemblyName>Guardrail</AssemblyName>
    <Product>Guardrail EHS</Product>
    <Company>Bytehawk Studio</Company>
    <Description>Free, open-source, self-hosted EHS and fleet safety software.</Description>
    <!-- Releasing: change this and push to main. CI builds, tests and publishes GitHub Release v<Version>. -->
    <Version>0.14.0</Version>
    <Authors>Bytehawk Studio</Authors>
    <Copyright>Copyright (c) 2026 Adam Glassner. MIT License.</Copyright>
    <!-- Lets the project at least restore/compile on non-Windows CI; the app itself is Windows-only. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\guardrail.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Single-file publish (build.ps1): bundle WPF's native DLLs into the exe too. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Guardrail.CrashReview\Guardrail.CrashReview.csproj" />
    <!-- Guardrail Server's sync protocol and API client (server/Guardrail.Sync) -->
    <ProjectReference Include="..\..\server\Guardrail.Sync\Guardrail.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\guardrail.ico" />
    <Resource Include="Assets\guardrail.png" />
    <!-- Emergency Response Guidebook 2024 data (see Services/ErgData.cs) -->
    <EmbeddedResource Include="Assets\erg2024.json.gz" LogicalName="erg2024.json.gz" />
  </ItemGroup>

</Project>
