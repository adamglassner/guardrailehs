<UserControl x:Class="Guardrail.Views.DotAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Export_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                    <TextBlock Text="Export audit report" />
                </StackPanel>
            </Button>
            <Border Width="52" Height="52" CornerRadius="10" Margin="0,0,14,0" Background="{DynamicResource Brush.AccentSoft}">
                <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="DOT Compliance Audit" Style="{StaticResource PageTitle}" />
                <TextBlock Text="A mock DOT audit, run live against your driver files, vehicles, DVIRs, maintenance, accident register and logs."
                           Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <UniformGrid Rows="1" Margin="0,0,-12,16">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiReadiness" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Audit readiness (checks passing)" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiGaps" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Danger}" />
                    <TextBlock Text="Gaps to fix" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiDrivers" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Driver files checked" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiVehicles" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Vehicles checked" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <StackPanel>
                <Border Background="{DynamicResource Brush.SurfaceAlt}" Padding="16,10" CornerRadius="6,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="REQUIREMENT" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="1" Text="RESULT" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="2" Text="STATUS" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="3" Text="WHAT TO FIX" Style="{StaticResource TableHeader}" />
                    </Grid>
                </Border>
                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TableRow}" Click="Row_Click" ToolTip="Go to these records">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="1.5*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Requirement}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Rule}" FontSize="11" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding ResultText, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                                    <Border Grid.Column="2" Style="{StaticResource StatusPill}" Tag="{Binding Status, Mode=OneWay}">
                                        <TextBlock Text="{Binding Status, Mode=OneWay}" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding GapsText, Mode=OneWay}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="2,8,0,0" TextWrapping="Wrap"
                   Text="A planning aid, not legal advice: a real DOT compliance review also looks at drug and alcohol testing, insurance and other records Guardrail doesn't track yet." />
    </StackPanel>
</UserControl>
