<UserControl x:Class="Guardrail.Views.AiReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Title -->
        <DockPanel Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Choose_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                    <TextBlock Text="Analyze videos" />
                </StackPanel>
            </Button>
            <Border Width="56" Height="56" CornerRadius="16" Margin="0,0,14,0" Background="{DynamicResource Brush.SurfaceWarm}"
                    BorderBrush="{DynamicResource Brush.BorderWarm}" BorderThickness="1">
                <TextBlock Text="&#xE99A;" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Warm}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Crash Review AI" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource SoonPill}" Margin="12,0,0,0" Background="{DynamicResource Brush.Warm}" BorderBrush="{DynamicResource Brush.Warm}">
                        <TextBlock Text="NEW" Style="{StaticResource PillText}" Foreground="White" />
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Give it dashcam or CCTV video. The AI finds the collision, follows every vehicle and works out who was most likely at fault — automatically, on this PC." />
            </StackPanel>
        </DockPanel>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Drop zone + what's running now -->
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Grid x:Name="DropZone" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave"
                          Background="Transparent" MinHeight="200">
                        <Rectangle x:Name="DropOutline" Margin="14" RadiusX="12" RadiusY="12" StrokeThickness="2" StrokeDashArray="5 4"
                                   Stroke="{DynamicResource Brush.Border}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                            <Border Width="54" Height="54" CornerRadius="27" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <TextBlock Text="Drop accident videos here" FontSize="17" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                                       HorizontalAlignment="Center" Margin="0,12,0,4" />
                            <TextBlock Text="MP4, MOV, AVI, MKV or WebM · dashcam (including split-screen cab + road) or fixed camera"
                                       Style="{StaticResource Muted}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                            <Button Style="{StaticResource GhostButton}" Click="Choose_Click" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                    <TextBlock Text="Choose videos…" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="NowPanel" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,1,0,0" CornerRadius="0,0,13,13" Padding="20,14" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="NowPercent" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                                <TextBlock x:Name="NowTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <Grid Margin="0,8,0,6" Height="6">
                                <Border x:Name="NowTrack" CornerRadius="3" Background="{DynamicResource Brush.Track}" />
                                <Border x:Name="NowFill" CornerRadius="3" Background="{DynamicResource Brush.Accent}" HorizontalAlignment="Left" Width="0" />
                            </Grid>
                            <TextBlock x:Name="NowStage" Style="{StaticResource Muted}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Automatic mode -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="AUTOMATIC MODE" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="Watch a folder" FontWeight="SemiBold" />
                    <TextBlock x:Name="WatchText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Style="{StaticResource SmallButton}" Click="WatchFolder_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,5,0" />
                                <TextBlock x:Name="WatchButtonText" Text="Choose folder…" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopWatchButton" Style="{StaticResource SmallButton}" Click="StopWatch_Click" Content="Stop watching" />
                    </StackPanel>
                    <CheckBox x:Name="AccidentsCheck" Click="Option_Click" Margin="0,0,0,8"
                              Content="Analyze videos attached to accidents in the Accident Register" />
                    <CheckBox x:Name="PreventCheck" Click="Option_Click"
                              Content="Set preventability on those accidents when the AI is at least 70% sure" />
                    <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="10" Padding="12,9" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Brush.Accent}" Margin="0,1,8,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="PrivacyText" FontSize="12" TextWrapping="Wrap" Width="280"
                                       Text="Runs entirely on this PC. Video never leaves it, and there are no per-video fees." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- KPIs -->
        <UniformGrid Rows="1" Margin="0,0,-12,16">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiTotal" Style="{StaticResource BigNumber}" FontSize="30" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Videos reviewed" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiCamera" Style="{StaticResource BigNumber}" FontSize="30" Foreground="{DynamicResource Brush.Danger}" />
                    <TextBlock Text="Our vehicle at fault" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiOther" Style="{StaticResource BigNumber}" FontSize="30" Foreground="{DynamicResource Brush.Success}" />
                    <TextBlock Text="Other party at fault" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiUnclear" Style="{StaticResource BigNumber}" FontSize="30" Foreground="{DynamicResource Brush.Warm}" />
                    <TextBlock Text="Shared, unclear or no collision" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Reviews table -->
        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <StackPanel>
                <Border Background="{DynamicResource Brush.SurfaceAlt}" Padding="16,10" CornerRadius="14,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CR #" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="1" Text="ADDED" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="2" Text="VIDEO" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="3" Text="WHAT HAPPENED" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="4" Text="VERDICT" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="5" Text="SURE" Style="{StaticResource TableHeader}" />
                    </Grid>
                </Border>

                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TableRow}" Click="Row_Click" ToolTip="Open the report">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number, Mode=OneWay}" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding DateText, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding VideoName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Source, Mode=OneWay}" FontSize="11" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CameraText, Mode=OneWay}" FontSize="11" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding CameraText, Converter={StaticResource NonEmptyToVis}}" />
                                    </StackPanel>
                                    <Border Grid.Column="4" Style="{StaticResource StatusPill}" Tag="{Binding DisplayStatus, Mode=OneWay}">
                                        <TextBlock Text="{Binding DisplayStatus, Mode=OneWay}" />
                                    </Border>
                                    <TextBlock Grid.Column="5" Text="{Binding ConfidenceText, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" Margin="0,40,0,44">
                    <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock Text="No videos reviewed yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock Text="Drop a video above, pick a watch folder, or attach video to an accident in Fleet Hub." Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="2,10,0,0" TextWrapping="Wrap"
                   Text="How it works: an object detector (YOLOX-S) finds every vehicle, rider and pedestrian; Guardrail tracks them, measures how the camera vehicle moved, finds the impact and applies rules of the road (following distance, lane changes, centre lines, signals). Results are estimates from the video alone." />
    </StackPanel>
</UserControl>
