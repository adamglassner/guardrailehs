<UserControl x:Class="Guardrail.Views.AiReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Title -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="52" Height="52" CornerRadius="10" Margin="0,0,14,0" Background="{DynamicResource Brush.SurfaceWarm}"
                    BorderBrush="{DynamicResource Brush.BorderWarm}" BorderThickness="1">
                <TextBlock Text="&#xE99A;" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Warm}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Crash Review AI" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource SoonPill}" Margin="12,0,6,0" Background="{DynamicResource Brush.Warm}">
                        <TextBlock Text="NEW" Style="{StaticResource PillText}" Foreground="White" />
                    </Border>
                    <Border Style="{StaticResource SoonPill}">
                        <TextBlock Text="COMING SOON" Style="{StaticResource PillText}" />
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="Drop in dashcam, CCTV, body-cam or phone video. AI watches the footage and determines who was at fault — automatically, no human input required." />
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Left: upload + example output ===== -->
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                    <Grid x:Name="DropZone" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver"
                          Background="Transparent" MinHeight="250">
                        <Rectangle Margin="14" RadiusX="8" RadiusY="8" StrokeThickness="2" StrokeDashArray="5 4"
                                   Stroke="{DynamicResource Brush.Border}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                            <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="Drop accident video here" FontSize="17" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,12,0,4" />
                            <TextBlock Text="MP4, MOV, AVI or MKV · dashcam, CCTV, body-cam, phone" Style="{StaticResource Muted}"
                                       HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Click="Soon_Click" Tag="Video upload" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                        <TextBlock Text="Browse for video…" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Click="Soon_Click" Tag="Linking video to an existing accident">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71B;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                        <TextBlock Text="Attach to accident…" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Example output (clearly not real) -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SoonPill}">
                                <TextBlock Text="EXAMPLE OUTPUT · NOT REAL" Style="{StaticResource PillText}" />
                            </Border>
                            <TextBlock Text="FAULT DETERMINATION" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>

                        <Grid Margin="0,4,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80*" />
                                <ColumnDefinition Width="20*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource Brush.Danger}" CornerRadius="4,0,0,4" Padding="10,7">
                                <TextBlock Text="Vehicle B · 80%" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource Brush.Skeleton}" CornerRadius="0,4,4,0" Padding="10,7">
                                <TextBlock Text="A · 20%" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"
                                   Text="Confidence 91% · Analyzed 00:00:42 of footage · Preventability (FMCSA-style): Preventable for Vehicle B" />

                        <TextBlock Text="KEY FACTORS" Style="{StaticResource SectionLabel}" />
                        <StackPanel>
                            <TextBlock Margin="0,2" TextWrapping="Wrap" Text="•  00:17 — Vehicle B enters intersection 1.4 s after signal turns red" />
                            <TextBlock Margin="0,2" TextWrapping="Wrap" Text="•  00:19 — Vehicle B estimated 41 mph in a 30 mph zone" />
                            <TextBlock Margin="0,2" TextWrapping="Wrap" Text="•  00:20 — Vehicle A braking begins 0.8 s before impact (reasonable reaction)" />
                            <TextBlock Margin="0,2" TextWrapping="Wrap" Text="•  00:21 — Impact, Vehicle B front to Vehicle A passenger side" />
                        </StackPanel>

                        <!-- Timeline strip -->
                        <Grid Margin="0,16,0,0" Height="28">
                            <Border Height="6" CornerRadius="3" Background="{DynamicResource Brush.Skeleton}" VerticalAlignment="Center" />
                            <Canvas x:Name="Timeline" VerticalAlignment="Center" Height="28" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== Right: how it works + options ===== -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="HOW IT WILL WORK" Style="{StaticResource SectionLabel}" />
                        <ItemsControl x:Name="Steps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" VerticalAlignment="Top"
                                                HorizontalAlignment="Left" Background="{DynamicResource Brush.AccentSoft}">
                                            <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="OPTIONS (COMING SOON)" Style="{StaticResource SectionLabel}" />
                        <CheckBox IsChecked="True" IsEnabled="False" Content="Fully automatic — no human review required" />
                        <CheckBox IsChecked="True" IsEnabled="False" Content="Run AI models locally on your own hardware" />
                        <CheckBox IsChecked="True" IsEnabled="False" Content="Attach report to the Accident Register automatically" />
                        <CheckBox IsChecked="False" IsEnabled="False" Content="Blur faces and license plates in exported clips" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"
                                   Text="Video never leaves your server. No cloud fees, no per-video charges — free and open source like the rest of Guardrail." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
