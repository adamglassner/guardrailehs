<UserControl x:Class="Guardrail.Views.ObservationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Title -->
        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Click="Export_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="Export CSV" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="New_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="New observation" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Border Width="52" Height="52" CornerRadius="10" Margin="0,0,14,0" Background="{DynamicResource Brush.AccentSoft}">
                <TextBlock Text="&#xE890;" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Accent}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Observations" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Hazard reports and good catches from anyone. Turn any of them into an action in one click." Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- KPIs -->
        <UniformGrid Rows="1" Margin="0,0,-12,16">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="Kpi30" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Reported in the last 30 days" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiOpen" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Warm}" />
                    <TextBlock Text="Open" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiGood" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Success}" />
                    <TextBlock Text="Good catches (30 days)" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiActions" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Turned into actions" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filters + search -->
        <DockPanel Margin="0,0,0,6">
            <Grid DockPanel.Dock="Right" Width="300" VerticalAlignment="Top">
                <TextBox x:Name="SearchBox" Padding="28,6,6,6" TextChanged="Search_Changed" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="9,0,0,0" HorizontalAlignment="Left"
                           Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="Search observations…" Margin="30,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
            </Grid>
            <WrapPanel x:Name="FilterChips">
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="ObsFilter" Content="All" Tag="All" Checked="Filter_Checked" />
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="ObsFilter" Content="Open" Tag="Open" Checked="Filter_Checked" />
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="ObsFilter" Content="Hazards" Tag="Hazards" Checked="Filter_Checked" />
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="ObsFilter" Content="Good catches" Tag="Good" Checked="Filter_Checked" />
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="ObsFilter" Content="Closed" Tag="Closed" Checked="Filter_Checked" />
            </WrapPanel>
        </DockPanel>

        <!-- Table -->
        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <StackPanel>
                <Border Background="{DynamicResource Brush.SurfaceAlt}" Padding="16,10" CornerRadius="6,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OBS #" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="1" Text="DATE" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="2" Text="TYPE" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="3" Text="WHAT WAS SEEN" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="4" Text="LOCATION" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="5" Text="REPORTED BY" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="6" Text="STATUS" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="7" Text="ACTION" Style="{StaticResource TableHeader}" />
                    </Grid>
                </Border>

                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TableRow}" Click="Row_Click" ToolTip="Click to edit">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number, Mode=OneWay}" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding DateText, Mode=OneWay}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TypeIcon" Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource Brush.Warm}" />
                                        <TextBlock Text="{Binding Type}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Description}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding Location}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="5" Text="{Binding ReportedBy}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Border Grid.Column="6" Style="{StaticResource StatusPill}" Tag="{Binding Status}">
                                        <TextBlock Text="{Binding Status}" />
                                    </Border>
                                    <Grid Grid.Column="7" VerticalAlignment="Center">
                                        <Button x:Name="CreateActionButton" Content="Create action" Style="{StaticResource SmallButton}"
                                                HorizontalAlignment="Left" Click="CreateAction_Click"
                                                ToolTip="Turn this observation into a tracked action" />
                                        <TextBlock x:Name="LinkedText" Text="{Binding LinkedAction}" Foreground="{DynamicResource Brush.Accent}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsGoodCatch, Mode=OneWay}" Value="True">
                                    <Setter TargetName="TypeIcon" Property="Text" Value="&#xE734;" />
                                    <Setter TargetName="TypeIcon" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CanCreateAction, Mode=OneWay}" Value="False">
                                    <Setter TargetName="CreateActionButton" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="LinkedText" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" Margin="0,40,0,44">
                    <TextBlock Text="&#xE890;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock x:Name="CountText" Style="{StaticResource Muted}" FontSize="11.5" Margin="2,8,0,0" />
    </StackPanel>
</UserControl>
