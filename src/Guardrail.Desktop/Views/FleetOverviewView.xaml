<UserControl x:Class="Guardrail.Views.FleetOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,18">
            <Border Width="52" Height="52" CornerRadius="10" Margin="0,0,14,0" Background="{DynamicResource Brush.AccentSoft}">
                <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Fleet Overview" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Everything in the fleet that's overdue or coming up, in one list. Click a row to go there."
                           Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <UniformGrid Rows="1" Margin="0,0,-12,16">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiDrivers" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Active drivers" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiVehicles" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Success}" />
                    <TextBlock Text="Vehicles in service" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiOverdue" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Danger}" />
                    <TextBlock Text="Overdue or out of compliance" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiSoon" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Warm}" />
                    <TextBlock Text="Coming up in the next 30 days" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Text="NEEDS ATTENTION" Style="{StaticResource SectionLabel}" />
        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <StackPanel>
                <Border Background="{DynamicResource Brush.SurfaceAlt}" Padding="16,10" CornerRadius="6,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="AREA" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="1" Text="WHAT" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="2" Text="PROBLEM" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="3" Text="DATE" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource TableHeader}" />
                    </Grid>
                </Border>
                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TableRow}" Click="Row_Click" ToolTip="Go there">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Area}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Item}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Problem}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding DueText, Mode=OneWay}" VerticalAlignment="Center" />
                                    <Border Grid.Column="4" Style="{StaticResource StatusPill}" Tag="{Binding Severity}">
                                        <TextBlock Text="{Binding Severity}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" Margin="0,40,0,44">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Success}" />
                    <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
