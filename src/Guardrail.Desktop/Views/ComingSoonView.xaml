<UserControl x:Class="Guardrail.Views.ComingSoonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Generic page for any module that isn't built yet. DataContext = ModuleInfo. -->
    <StackPanel>
        <!-- Title -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="52" Height="52" CornerRadius="10" Margin="0,0,14,0"
                    Background="{DynamicResource Brush.AccentSoft}">
                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="24"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource SoonPill}" Margin="12,0,0,0">
                        <TextBlock Text="COMING SOON" Style="{StaticResource PillText}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Tagline}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Action bar (every button just says "coming soon") -->
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Click="Soon_Click" Tag="Filters" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71C;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="Filters" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Click="Soon_Click" Tag="Export to Excel / PDF" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="Soon_Click" Tag="{Binding PrimaryAction}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding PrimaryAction}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Grid MaxWidth="360" HorizontalAlignment="Left">
                <TextBox x:Name="SearchBox" Padding="28,6,6,6" Width="360" IsReadOnly="True"
                         Text="Search…" Foreground="{DynamicResource Brush.TextMuted}"
                         PreviewMouseLeftButtonDown="Search_Click" Cursor="Arrow" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="9,0,0,0" HorizontalAlignment="Left"
                           Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>

        <!-- KPI tiles -->
        <ItemsControl x:Name="KpiPanel" ItemsSource="{Binding Kpis}" Margin="0,0,-12,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="—" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Placeholder table -->
        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16" ClipToBounds="True">
            <Grid x:Name="TableHost" MinHeight="250">
                <!-- Skeleton grid is inserted here from code-behind -->
                <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="26,18" Margin="0,36,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="26" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Warm}" />
                        <TextBlock Text="No records yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,2" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource Muted}">
                            <Run Text="{Binding Title, Mode=OneWay}" /><Run Text=" is coming soon to Guardrail." />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- About + planned features -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ABOUT THIS MODULE" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="20" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="PLANNED FEATURES" Style="{StaticResource SectionLabel}" />
                    <ItemsControl ItemsSource="{Binding Features}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4,14,4">
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11"
                                               Foreground="{DynamicResource Brush.Accent}" Margin="0,2,8,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
