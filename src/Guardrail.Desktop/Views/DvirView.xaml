<UserControl x:Class="Guardrail.Views.DvirView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Title -->
        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Click="Export_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="Export CSV" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="New_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="New DVIR" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Border Width="52" Height="52" CornerRadius="10" Margin="0,0,14,0" Background="{DynamicResource Brush.AccentSoft}">
                <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Accent}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="DVIR Inspections" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Pre-trip and post-trip driver vehicle inspection reports. Defects stay open until a repair is certified." Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- KPIs -->
        <UniformGrid Rows="1" Margin="0,0,-12,16">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiWeek" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="DVIRs in the last 7 days" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiReported" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Warm}" />
                    <TextBlock Text="Defects reported, last 30 days" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiOpen" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Danger}" />
                    <TextBlock Text="Defects not yet repaired" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiRepaired" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Success}" />
                    <TextBlock Text="Repairs certified, last 30 days" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filters + search -->
        <DockPanel Margin="0,0,0,6">
            <Grid DockPanel.Dock="Right" Width="300" VerticalAlignment="Top">
                <TextBox x:Name="SearchBox" Padding="28,6,6,6" TextChanged="Search_Changed" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="9,0,0,0" HorizontalAlignment="Left"
                           Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="Search…" Margin="30,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
            </Grid>
            <WrapPanel x:Name="FilterChips">
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="DvirViewFilter" Content="All" Tag="All" Checked="Filter_Checked" />
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="DvirViewFilter" Content="Defects open" Tag="Open" Checked="Filter_Checked" />
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="DvirViewFilter" Content="Repaired" Tag="Repaired" Checked="Filter_Checked" />
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="DvirViewFilter" Content="No defects" Tag="None" Checked="Filter_Checked" />
            </WrapPanel>
        </DockPanel>

        <!-- Table -->
        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <StackPanel>
                <Border Background="{DynamicResource Brush.SurfaceAlt}" Padding="16,10" CornerRadius="6,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="75" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="85" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="115" />
                            <ColumnDefinition Width="125" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DVIR #" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="1" Text="DATE" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="2" Text="UNIT" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="3" Text="DRIVER" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="4" Text="TRIP" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="5" Text="DEFECTS" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="6" Text="STATUS" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="7" Text="" Style="{StaticResource TableHeader}" />
                    </Grid>
                </Border>

                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TableRow}" Click="Row_Click" ToolTip="Click to edit">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="115" />
                                        <ColumnDefinition Width="125" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Number, Mode=OneWay}" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding DateText, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding UnitNumber, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="{Binding Driver, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding TripType, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="5" Text="{Binding DefectsText, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="NoWrap" />
                                    <Border Grid.Column="6" Style="{StaticResource StatusPill}" Tag="{Binding DisplayStatus, Mode=OneWay}"><TextBlock Text="{Binding DisplayStatus, Mode=OneWay}" /></Border>
                                    <Button x:Name="CertifyButton" Grid.Column="7" Content="Certify repair" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Certify_Click" ToolTip="Mechanic certifies the defects were repaired" />
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding DefectsOpen, Mode=OneWay}" Value="False">
                                    <Setter TargetName="CertifyButton" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" Margin="0,40,0,44">
                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock x:Name="CountText" Style="{StaticResource Muted}" FontSize="11.5" Margin="2,8,0,0" />
    </StackPanel>
</UserControl>
