<UserControl x:Class="Guardrail.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Title -->
        <DockPanel Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Right" Text="Reporting year: 2026" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
                <Border Style="{StaticResource SoonPill}" Margin="12,0,0,0"
                        ToolTip="Action counts come from your real Actions. Everything else on this page is a made-up example until Incidents and Monthly Data are built.">
                    <TextBlock Text="ACTIONS ARE LIVE · OTHER FIGURES ARE SAMPLE DATA" Style="{StaticResource PillText}" />
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- Filters -->
        <WrapPanel Margin="0,0,0,18">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Corporate" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Width="200" IsReadOnly="True" Text="All corporate" PreviewMouseLeftButtonDown="Filter_Click" Cursor="Hand" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Region" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Width="200" IsReadOnly="True" Text="All regions" PreviewMouseLeftButtonDown="Filter_Click" Cursor="Hand" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="District" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Width="200" IsReadOnly="True" Text="All districts" PreviewMouseLeftButtonDown="Filter_Click" Cursor="Hand" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Location" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Width="200" IsReadOnly="True" Text="All locations" PreviewMouseLeftButtonDown="Filter_Click" Cursor="Hand" />
            </StackPanel>
            <Button Content="Search" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                    Click="Soon_Click" Tag="Dashboard filtering" />
        </WrapPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Left column ===== -->
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="2" Padding="12,18">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="48" FontSize="58" FontWeight="Light" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="INJURY-FREE DAYS" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="Last injury: sample date" FontSize="10" HorizontalAlignment="Center"
                                       Style="{StaticResource Muted}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Background="{DynamicResource Brush.SurfaceWarm}"
                            BorderBrush="{DynamicResource Brush.BorderWarm}" Padding="12,18">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="212" FontSize="58" FontWeight="Light" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Warm}" />
                            <TextBlock Text="VEHICLE INCIDENT-FREE DAYS" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.WarmText}" />
                            <TextBlock Text="Last vehicle incident: sample date" FontSize="10" HorizontalAlignment="Center"
                                       Style="{StaticResource Muted}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="TYPE OF INCIDENT" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}" Padding="0" Background="{DynamicResource Brush.SurfaceWarm}"
                        BorderBrush="{DynamicResource Brush.BorderWarm}">
                    <ItemsControl x:Name="IncidentTypes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.BorderWarm}">
                                    <Button Style="{StaticResource RowButton}" Click="Soon_Click" Tag="{Binding Name}" Padding="16,17">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="20" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="18"
                                                       Foreground="{DynamicResource Brush.Warm}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="20" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Warm}" />
                                            <TextBlock Grid.Column="3" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11"
                                                       Foreground="{DynamicResource Brush.Warm}" />
                                        </Grid>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- ===== Right column ===== -->
            <StackPanel Grid.Column="2">
                <ItemsControl x:Name="ActionCards" Margin="0,0,-14,18">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CardButton}" Margin="0,0,14,0" Click="ActionCard_Click"
                                    ToolTip="Open Actions">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Count}" FontSize="26" FontWeight="Light" Margin="0,0,16,0"
                                               Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="14"
                                               FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.3*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="OSHA EVENT TYPE" Style="{StaticResource SectionLabel}" />
                            <Canvas x:Name="Donut" Width="210" Height="210" Margin="0,8,0,14" HorizontalAlignment="Center" />
                            <ItemsControl x:Name="DonutLegend" HorizontalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <Ellipse Width="9" Height="9" Fill="{Binding Brush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock FontSize="11.5">
                                                <Run Text="{Binding Label, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Value, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="OSHA INCIDENTS BY LOCATION" Style="{StaticResource SectionLabel}" />
                            <Grid x:Name="BarChart" Margin="0,10,0,0" />
                        </DockPanel>
                    </Border>
                </Grid>

                <TextBlock Text="US SAFETY CALCULATIONS" Style="{StaticResource SectionLabel}" />
                <ItemsControl x:Name="Rates" Margin="0,0,-12,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="12,14" ToolTip="{Binding Help}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Value}" FontSize="20" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" FontSize="11" Style="{StaticResource Muted}"
                                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
