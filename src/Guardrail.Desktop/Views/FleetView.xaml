<UserControl x:Class="Guardrail.Views.FleetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Fleet Hub side navigation -->
        <StackPanel VerticalAlignment="Top">
            <Border Style="{StaticResource Card}" Padding="8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,6,0,10">
                        <TextBlock Text="&#xE804;" Style="{StaticResource Icon}" FontSize="16"
                                   Foreground="{DynamicResource Brush.Warm}" Margin="0,0,8,0" />
                        <TextBlock Text="Fleet Hub" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <ItemsControl x:Name="SectionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource SubNavRadio}" GroupName="FleetNav"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             Checked="Section_Checked" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Background="{DynamicResource Brush.SurfaceWarm}"
                    BorderBrush="{DynamicResource Brush.BorderWarm}">
                <StackPanel>
                    <TextBlock Text="FMCSA-READY" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Brush.WarmText}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                               Text="Driver files, DVIRs, hours of service and maintenance records kept together so a DOT audit is a report, not a scramble." />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Selected section -->
        <ContentControl x:Name="SectionHost" Grid.Column="2" />
    </Grid>
</UserControl>
