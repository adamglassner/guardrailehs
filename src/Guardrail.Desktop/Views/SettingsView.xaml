<UserControl x:Class="Guardrail.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,18" />

        <!-- Appearance: this one actually works -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" />
                <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="Match Windows (light or dark)" Checked="Theme_Checked" Tag="System" />
                <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Light" Checked="Theme_Checked" Tag="Light" />
                <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Dark" Checked="Theme_Checked" Tag="Dark" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="YOUR DATA" Style="{StaticResource SectionLabel}" />
                <TextBlock x:Name="DataText" Style="{StaticResource Muted}" Margin="0,0,0,10" TextWrapping="Wrap" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OpenDataFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                            <TextBlock Text="Open folder" />
                        </StackPanel>
                    </Button>
                    <TextBox x:Name="DataFolderBox" IsReadOnly="True" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Backup_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                            <TextBlock Text="Back up…" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="Restore_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                            <TextBlock Text="Restore…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel>
                    <Border x:Name="ProtectionPill" DockPanel.Dock="Right" Style="{StaticResource StatusPill}">
                        <TextBlock x:Name="ProtectionPillText" />
                    </Border>
                    <TextBlock Text="PIN / PASSWORD PROTECTION" Style="{StaticResource SectionLabel}" />
                </DockPanel>
                <TextBlock x:Name="ProtectionText" Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap" />
                <StackPanel x:Name="ProtectionButtons" Orientation="Horizontal" />
                <StackPanel x:Name="AutoLockRow" Margin="0,14,0,0">
                    <TextBlock Text="Lock the window after this long without use" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <WrapPanel x:Name="AutoLockChips" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel>
                    <Border x:Name="ServerPill" DockPanel.Dock="Right" Style="{StaticResource StatusPill}">
                        <TextBlock x:Name="ServerPillText" />
                    </Border>
                    <TextBlock Text="GUARDRAIL SERVER (OPTIONAL)" Style="{StaticResource SectionLabel}" />
                </DockPanel>
                <TextBlock x:Name="ServerText" Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap" />
                <StackPanel x:Name="ServerDetails" Margin="0,0,0,12" />
                <WrapPanel x:Name="ServerButtons" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="ORGANIZATION" Style="{StaticResource SectionLabel}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10" TextWrapping="Wrap"
                           Text="Set up your corporate → region → district → location hierarchy. Every Location field in GuardHawk offers these sites." />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="Locations_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE707;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                            <TextBlock Text="Locations" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="LocationsSummary" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Users &amp; roles" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="UsersRoles_Click" />
                    <Button Content="Custom fields" Style="{StaticResource GhostButton}" Click="Soon_Click" Tag="Custom fields" />
                    <Border Style="{StaticResource SoonPill}" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="COMING SOON" Style="{StaticResource PillText}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}" />
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/guardrail.png" Width="36" Height="36" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="VersionText" FontSize="15" FontWeight="SemiBold" Text="GuardHawk" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="Free and open source under the MIT License. No subscriptions, no per-employee pricing, no contracts." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
