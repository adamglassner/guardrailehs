<UserControl x:Class="Guardrail.Views.PermitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Title -->
        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Click="Export_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="Export CSV" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="New_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="Issue permit" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Border Width="52" Height="52" CornerRadius="10" Margin="0,0,14,0" Background="{DynamicResource Brush.AccentSoft}">
                <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Accent}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Work Permits" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Hot work, confined space, working at height and other high-risk jobs: issued, active and closed out." Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- KPIs -->
        <UniformGrid Rows="1" Margin="0,0,-12,16">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiActive" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Active permits" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiToday" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Success}" />
                    <TextBlock Text="Valid today" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiExpired" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Danger}" />
                    <TextBlock Text="Expired, not closed out" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiMonth" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Issued in the last 30 days" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filters + search -->
        <DockPanel Margin="0,0,0,6">
            <Grid DockPanel.Dock="Right" Width="300" VerticalAlignment="Top">
                <TextBox x:Name="SearchBox" Padding="28,6,6,6" TextChanged="Search_Changed" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="9,0,0,0" HorizontalAlignment="Left"
                           Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="Search…" Margin="30,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
            </Grid>
            <WrapPanel x:Name="FilterChips">
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="PermitsViewFilter" Content="All" Tag="All" Checked="Filter_Checked" />
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="PermitsViewFilter" Content="Active" Tag="Active" Checked="Filter_Checked" />
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="PermitsViewFilter" Content="Expired" Tag="Expired" Checked="Filter_Checked" />
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="PermitsViewFilter" Content="Closed" Tag="Closed" Checked="Filter_Checked" />
            </WrapPanel>
        </DockPanel>

        <!-- Table -->
        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <StackPanel>
                <Border Background="{DynamicResource Brush.SurfaceAlt}" Padding="16,10" CornerRadius="6,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PERMIT #" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="1" Text="TYPE" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="2" Text="WORK" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="3" Text="ISSUED TO" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="4" Text="VALID" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="5" Text="STATUS" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="6" Text="" Style="{StaticResource TableHeader}" />
                    </Grid>
                </Border>

                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TableRow}" Click="Row_Click" ToolTip="Click to edit">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="145" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Number, Mode=OneWay}" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Type, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="{Binding Work, Mode=OneWay}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Location, Mode=OneWay}" FontSize="11" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{Binding Location, Converter={StaticResource NonEmptyToVis}}" /></StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding IssuedTo, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding ValidText, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Border Grid.Column="5" Style="{StaticResource StatusPill}" Tag="{Binding DisplayStatus, Mode=OneWay}"><TextBlock Text="{Binding DisplayStatus, Mode=OneWay}" /></Border>
                                    <Button x:Name="CloseButton" Content="Close out" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,6,0" Click="Close_Click" ToolTip="The work is finished and the area is safe: close the permit"></Button>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="False">
                                    <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" Margin="0,40,0,44">
                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock x:Name="CountText" Style="{StaticResource Muted}" FontSize="11.5" Margin="2,8,0,0" />
    </StackPanel>
</UserControl>
