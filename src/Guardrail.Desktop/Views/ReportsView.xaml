<UserControl x:Class="Guardrail.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Title -->
        <DockPanel x:Name="TitleRow" Margin="0,0,0,18">
            <Border Width="52" Height="52" CornerRadius="10" Margin="0,0,14,0" Background="{DynamicResource Brush.AccentSoft}">
                <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Accent}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PageTitleText" Text="Reports" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="PageTagline" Text="OSHA logs, rates and exception reports from your records. Preview, then export to CSV for Excel."
                           Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Report list -->
            <Border Style="{StaticResource Card}" Padding="8" VerticalAlignment="Top">
                <ItemsControl x:Name="ReportGroups">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Category}" Style="{StaticResource SectionLabel}" Margin="10,6,0,4" />
                                <ItemsControl ItemsSource="{Binding Reports}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource SubNavRadio}" GroupName="ReportNav" Checked="Report_Checked" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Preview -->
            <StackPanel Grid.Column="2">
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Export_Click" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                            <TextBlock Text="Export CSV" />
                        </StackPanel>
                    </Button>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock x:Name="ReportTitle" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="ReportDescription" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <WrapPanel x:Name="YearChips" Margin="0,0,0,4" />
                <TextBlock x:Name="SummaryText" FontWeight="SemiBold" Margin="2,4,0,10" TextWrapping="Wrap" />

                <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="Preview" />
                    </ScrollViewer>
                </Border>
                <TextBlock x:Name="PreviewNote" Style="{StaticResource Muted}" FontSize="11.5" Margin="2,8,0,0" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
