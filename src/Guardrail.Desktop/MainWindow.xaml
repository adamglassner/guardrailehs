<Window x:Class="Guardrail.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GuardHawk"
        Icon="pack://application:,,,/Assets/guardrail.ico"
        Width="1480" Height="920" MinWidth="1100" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid x:Name="RootGrid" Background="{DynamicResource Brush.Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}" Padding="14,22,14,14">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,18">
                    <Image Source="pack://application:,,,/Assets/guardrail.png" Width="36" Height="36" Margin="0,0,11,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.SidebarText}">
                            <Run Text="Guard" /><Run Text="rail" Foreground="{DynamicResource Brush.Highlight}" />
                        </TextBlock>
                        <TextBlock Text="EHS · SAFETY &amp; COMPLIANCE" FontSize="9.5" FontWeight="SemiBold" Margin="1,-1,0,0"
                                   Foreground="{DynamicResource Brush.SidebarHeading}" />
                    </StackPanel>
                </StackPanel>

                <!-- Bottom: data status, theme, settings -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Border Background="{DynamicResource Brush.SidebarCard}" CornerRadius="14" Padding="14,12" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"
                                           Foreground="{DynamicResource Brush.Highlight}" />
                                <TextBlock Text="Saved on this PC" FontWeight="SemiBold" Foreground="{DynamicResource Brush.SidebarText}" />
                            </StackPanel>
                            <TextBlock x:Name="DataDetail" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="17"
                                       Foreground="{DynamicResource Brush.SidebarMuted}" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="ThemeButton" Style="{StaticResource SidebarButton}" Click="Theme_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ThemeGlyph" Style="{StaticResource Icon}" FontSize="15" Width="28" />
                            <TextBlock x:Name="ThemeLabel" FontSize="13.5" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource SidebarButton}" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="15" Width="28" />
                            <TextBlock Text="Settings" FontSize="13.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Navigation, grouped (scrolls if the window is short) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl x:Name="NavGroups" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="Bold" Margin="12,4,0,4"
                                               Foreground="{DynamicResource Brush.SidebarHeading}" />
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource NavRadio}" GroupName="MainNav"
                                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                             ToolTip="{Binding Tagline}"
                                                             AutomationProperties.Name="{Binding Title}"
                                                             Checked="Module_Checked" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="38,30,38,36" Focusable="False">
                <ContentControl x:Name="PageHost" MaxWidth="1560" Focusable="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="PageShift" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </ScrollViewer>

            <!-- Status bar -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0" Padding="18,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11.5"
                               Text="Free &amp; open source (MIT) · no per-seat pricing, ever" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" FontSize="11.5" />
                </DockPanel>
            </Border>

            <!-- Toast -->
            <Border x:Name="Toast" Grid.RowSpan="2" Visibility="Collapsed" Opacity="0"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,48"
                    Background="{DynamicResource Brush.ToastBg}" CornerRadius="12" Padding="16,12" MaxWidth="480">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastShift" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"
                               Foreground="{DynamicResource Brush.Highlight}" />
                    <TextBlock x:Name="ToastText" Foreground="{DynamicResource Brush.ToastText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
