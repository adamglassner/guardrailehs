<Window x:Class="Guardrail.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guardrail EHS"
        Icon="pack://application:,,,/Assets/guardrail.ico"
        Width="1440" Height="900" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Header}" Padding="18,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/guardrail.png" Width="30" Height="30" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <TextBlock FontSize="21" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.HeaderText}">
                        <Run Text="Guard" /><Run Text="rail" Foreground="{DynamicResource Brush.Warm}" />
                    </TextBlock>
                    <TextBlock Text="EHS" FontSize="11" FontWeight="SemiBold" Margin="5,6,0,0"
                               Foreground="{DynamicResource Brush.HeaderText}" Opacity="0.7" VerticalAlignment="Center" />
                    <Border Width="1" Height="22" Background="{DynamicResource Brush.HeaderText}" Opacity="0.25" Margin="16,0" />
                    <TextBlock Text="Local Workspace" FontSize="15" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.HeaderText}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Brush.HeaderActive}" CornerRadius="10" Padding="10,3" Margin="0,0,14,0"
                            ToolTip="Records are saved on this PC. Syncing to a self-hosted Guardrail Server is coming soon.">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Warm}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Local mode · saved on this PC" FontSize="11" Foreground="{DynamicResource Brush.HeaderText}" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource HeaderButton}" Click="Profile_Click" ToolTip="Profile">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,7,0" />
                            <TextBlock Text="Local User" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ThemeButton" Style="{StaticResource HeaderButton}" Click="Theme_Click" Margin="4,0,0,0">
                        <TextBlock x:Name="ThemeGlyph" Style="{StaticResource Icon}" FontSize="16" />
                    </Button>

                    <Button Style="{StaticResource HeaderButton}" Click="Settings_Click" ToolTip="Settings">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="16" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Module toolbar ===== -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Toolbar}" Padding="12,4">
            <ItemsControl x:Name="ModuleBar">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource ToolbarRadio}" GroupName="MainNav"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     ToolTip="{Binding Tagline}"
                                     Checked="Module_Checked" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ===== Page ===== -->
        <ScrollViewer x:Name="PageScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="22,18,22,26">
            <ContentControl x:Name="PageHost" />
        </ScrollViewer>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="16,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11"
                           Text="Guardrail Server (self-hosted) — coming soon" />
                <TextBlock Style="{StaticResource Muted}" FontSize="11"
                           Text="Guardrail EHS v0.2.0 · free &amp; open source (MIT) · no per-seat pricing, ever" />
            </DockPanel>
        </Border>

        <!-- ===== Toast ===== -->
        <Border x:Name="Toast" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,44"
                Background="{DynamicResource Brush.ToastBg}" CornerRadius="6" Padding="16,11" MaxWidth="440">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,10,0"
                           Foreground="{DynamicResource Brush.Warm}" />
                <TextBlock x:Name="ToastText" Foreground="{DynamicResource Brush.ToastText}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
