<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Every key here must also exist in Light.xaml. -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#0F141A" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#18202A" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#1E2833" />
    <SolidColorBrush x:Key="Brush.SurfaceWarm" Color="#211E19" />
    <SolidColorBrush x:Key="Brush.Border" Color="#2A3542" />
    <SolidColorBrush x:Key="Brush.BorderWarm" Color="#4A3A22" />
    <SolidColorBrush x:Key="Brush.Skeleton" Color="#26313D" />
    <SolidColorBrush x:Key="Brush.Text" Color="#E5EAF0" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#8E9AA8" />
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="#18FFFFFF" />

    <SolidColorBrush x:Key="Brush.Header" Color="#0E2638" />
    <SolidColorBrush x:Key="Brush.HeaderText" Color="#E8F0F7" />
    <SolidColorBrush x:Key="Brush.HeaderActive" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Brush.Toolbar" Color="#132F45" />
    <SolidColorBrush x:Key="Brush.ToolbarHover" Color="#1B3F5B" />
    <SolidColorBrush x:Key="Brush.ToolbarSelected" Color="#245374" />
    <SolidColorBrush x:Key="Brush.ToolbarIcon" Color="#F5B24A" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#5CA8E8" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1A3247" />
    <SolidColorBrush x:Key="Brush.Warm" Color="#F0A23F" />
    <SolidColorBrush x:Key="Brush.WarmText" Color="#F0A23F" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#E2574C" />
    <SolidColorBrush x:Key="Brush.Success" Color="#7CC352" />

    <SolidColorBrush x:Key="Brush.ToastBg" Color="#E5EAF0" />
    <SolidColorBrush x:Key="Brush.ToastText" Color="#0F141A" />
</ResourceDictionary>
