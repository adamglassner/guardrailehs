<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:svc="clr-namespace:Guardrail.Services">
    <!-- Theme-independent styles. Colors come from Light.xaml / Dark.xaml via DynamicResource. -->

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <svc:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis" />
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== Text ===== -->
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!-- ===== Containers ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="SoonPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Buttons ===== -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
        <Grid>
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" />
            <Border x:Name="hover" Background="{DynamicResource Brush.HoverOverlay}" CornerRadius="4" Opacity="0" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="hover" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="hover" Property="Opacity" Value="1" />
                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{DynamicResource Brush.Warm}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,7" />
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.HeaderText}" />
        <Setter Property="Padding" Value="9,6" />
    </Style>
    <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="14,14" />
    </Style>
    <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="18,16" />
    </Style>

    <!-- ===== Main module toolbar item ===== -->
    <Style x:Key="ToolbarRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.HeaderText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Width="80" Margin="1,0">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" />
                        <Border x:Name="bar" Height="3" VerticalAlignment="Bottom" Margin="16,0"
                                CornerRadius="1.5" Background="{DynamicResource Brush.Warm}" Opacity="0" />
                        <StackPanel Margin="4,8,4,10" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="22"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource Brush.ToolbarIcon}" />
                            <TextBlock Text="{Binding ToolbarLabel}" FontSize="9.5" FontWeight="SemiBold"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource Brush.Warm}" CornerRadius="3" Padding="4,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,6,0">
                            <TextBlock Text="NEW" FontSize="8" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ToolbarHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ToolbarSelected}" />
                            <Setter TargetName="bar" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Side navigation item (Fleet Hub) ===== -->
    <Style x:Key="SubNavRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Margin="0,1">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" />
                        <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Margin="0,7"
                                CornerRadius="1.5" Background="{DynamicResource Brush.Accent}" Opacity="0" />
                        <DockPanel Margin="12,9">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                       FontSize="15" Width="28" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            <Setter TargetName="bar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Filter / choice chip ===== -->
    <Style x:Key="ChipRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" CornerRadius="14" Padding="13,5" BorderThickness="1"
                            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Status pill: set Tag to the status text ===== -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Overdue">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
            </Trigger>
            <Trigger Property="Tag" Value="Expired">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
            </Trigger>
            <Trigger Property="Tag" Value="In progress">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warm}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.WarmText}" />
            </Trigger>
            <Trigger Property="Tag" Value="Expiring soon">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warm}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.WarmText}" />
            </Trigger>
            <Trigger Property="Tag" Value="Action created">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warm}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.WarmText}" />
            </Trigger>
            <Trigger Property="Tag" Value="Closed">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
            </Trigger>
            <Trigger Property="Tag" Value="Current">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
            </Trigger>
            <Trigger Property="Tag" Value="No expiry">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PriorityText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="Text" Value="High">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="Text" Value="Low">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TableHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TableRow" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16,11" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- ===== Implicit styles so stock controls follow the theme ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Padding" Value="4,4" />
    </Style>
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    </Style>
</ResourceDictionary>
